{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gravity Omega",
  "version": "0.1.0",
  "identifier": "com.veritas.gravityomega.native",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Gravity Omega",
        "width": 1600,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Development",
    "shortDescription": "Linux-native Gravity Omega command center",
    "longDescription": "Rust/Tauri replacement workbench for Gravity Omega."
  }
}
